	measure 'V Total' = IF(SELECTEDVALUE(Vista[Vista],"Indicadores")="Proyectos", CALCULATE([Indicadores Evaluados], Dim_Catalogo[Proyecto]=1), [Indicadores Evaluados])
		formatString: #,0
		displayFolder: Resumen General\Vista
		lineageTag: 20e38f8e-21c5-441d-a385-5455cb90bd5a

	measure 'V Sobrecumplimiento' =
			VAR EsProyectos = SELECTEDVALUE(Vista[Vista],"Indicadores")="Proyectos"
			VAR IdsProyecto = CALCULATETABLE(VALUES(Fact_Cierres[Id]), Dim_Catalogo[Proyecto]=1)
			VAR UltimoPorId = ADDCOLUMNS(IdsProyecto, "@Fecha", CALCULATE(MAX(Fact_Cierres[Fecha])))
			VAR ResultadoProyectos = SUMX(UltimoPorId, VAR _id=Fact_Cierres[Id] VAR _f=[@Fecha] VAR _c=CALCULATE(SELECTEDVALUE(Fact_Cierres[Cumplimiento_norm]), Fact_Cierres[Id]=_id, Fact_Cierres[Fecha]=_f) RETURN IF(NOT ISBLANK(_c) && _c>=1, 1, 0))
			RETURN IF(EsProyectos, ResultadoProyectos, [N Sobrecumplimiento])
		formatString: #,0
		displayFolder: Resumen General\Vista
		lineageTag: f44c6c1f-b260-4ef6-bce8-eebec1c0e674

	measure 'V Cumplimiento' =
			VAR EsProyectos = SELECTEDVALUE(Vista[Vista],"Indicadores")="Proyectos"
			VAR IdsProyecto = CALCULATETABLE(VALUES(Fact_Cierres[Id]), Dim_Catalogo[Proyecto]=1)
			VAR UltimoPorId = ADDCOLUMNS(IdsProyecto, "@Fecha", CALCULATE(MAX(Fact_Cierres[Fecha])))
			VAR ResultadoProyectos = SUMX(UltimoPorId, VAR _id=Fact_Cierres[Id] VAR _f=[@Fecha] VAR _c=CALCULATE(SELECTEDVALUE(Fact_Cierres[Cumplimiento_norm]), Fact_Cierres[Id]=_id, Fact_Cierres[Fecha]=_f) RETURN IF(NOT ISBLANK(_c) && _c>0 && _c<1, 1, 0))
			RETURN IF(EsProyectos, ResultadoProyectos, [N Cumplimiento])
		formatString: #,0
		displayFolder: Resumen General\Vista
		lineageTag: 1212ad80-608c-4a6f-8089-16889f57b63f

	measure 'V Alerta' =
			VAR EsProyectos = SELECTEDVALUE(Vista[Vista],"Indicadores")="Proyectos"
			VAR IdsProyecto = CALCULATETABLE(VALUES(Fact_Cierres[Id]), Dim_Catalogo[Proyecto]=1)
			VAR UltimoPorId = ADDCOLUMNS(IdsProyecto, "@Fecha", CALCULATE(MAX(Fact_Cierres[Fecha])))
			VAR ResultadoProyectos = SUMX(UltimoPorId, VAR _id=Fact_Cierres[Id] VAR _f=[@Fecha] VAR _c=CALCULATE(SELECTEDVALUE(Fact_Cierres[Cumplimiento_norm]), Fact_Cierres[Id]=_id, Fact_Cierres[Fecha]=_f) RETURN IF(ISBLANK(_c) || _c=0, 1, 0))
			RETURN IF(EsProyectos, ResultadoProyectos, [N Alerta])
