table _Medidas
	lineageTag: 812b79ed-d3f1-4047-90ed-3813f63bd4ec

	measure 'Indicadores Evaluados' =
			VAR UltimoPorId = ADDCOLUMNS(VALUES(Fact_Cierres[Id]), "@Fecha", CALCULATE(MAX(Fact_Cierres[Fecha])))
			RETURN SUMX(UltimoPorId, VAR _id = Fact_Cierres[Id] VAR _f = [@Fecha] VAR _cat = CALCULATE(SELECTEDVALUE(Fact_Cierres[Categoria]), Fact_Cierres[Id] = _id, Fact_Cierres[Fecha] = _f) RETURN IF(NOT ISBLANK(_cat) && _cat <> "Sin dato", 1, 0))
		formatString: #,0
		displayFolder: Resumen General
		lineageTag: c6dc099c-8964-46ab-ad73-91a2345f3f85

	measure 'Cumplimiento Global %' =
			VAR UltimoPorId = ADDCOLUMNS(VALUES(Fact_Cierres[Id]), "@Fecha", CALCULATE(MAX(Fact_Cierres[Fecha])))
			VAR Suma = SUMX(UltimoPorId, VAR _id = Fact_Cierres[Id] VAR _f = [@Fecha] RETURN CALCULATE(SELECTEDVALUE(Fact_Cierres[Cumplimiento_norm]), Fact_Cierres[Id] = _id, Fact_Cierres[Fecha] = _f))
			RETURN DIVIDE(Suma, [Indicadores Evaluados])
		formatString: 0.0%
		displayFolder: Resumen General
		lineageTag: 522fea32-1ee9-4ac3-a6e5-122cb245202c

