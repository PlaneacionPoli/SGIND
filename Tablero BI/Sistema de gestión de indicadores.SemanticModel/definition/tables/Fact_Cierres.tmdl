	column Tipo_Registro
		dataType: string
		lineageTag: 0430c6bf-7d30-4b47-bd67-58533ff83404
		sourceColumn: Tipo_Registro

	column Cumplimiento_norm =
			VAR EsMetrica = LOWER(TRIM(COALESCE(Fact_Cierres[Tipo_Registro], ""))) = "metrica"
			VAR EsNoAplica = LOWER(TRIM(COALESCE(Fact_Cierres[Tipo_Registro], ""))) = "no aplica"
			VAR MetaNum = Fact_Cierres[Meta]
			VAR SinMeta = ISBLANK(MetaNum) || MetaNum = 0
			VAR SinReporte = NOT(EsMetrica) && (SinMeta || EsNoAplica)
			VAR Valor = Fact_Cierres[Cumplimiento]
			RETURN
			    IF(
			        EsMetrica || SinReporte || ISBLANK(Valor),
			        BLANK(),
			        IF(Valor > 1.3 && Valor <= 100, Valor / 100, IF(Valor >= 0 && Valor <= 1.3, Valor, BLANK()))
			    )
		dataType: double
		formatString: 0.0%
		lineageTag: 1659854e-7ca2-4334-a50e-c90fa6b02a81

	column EsMetrica = LOWER(TRIM(COALESCE(Fact_Cierres[Tipo_Registro], ""))) = "metrica"
		dataType: boolean
		lineageTag: 488cd798-dbf3-406d-8c30-f84efccae6d7

	column Categoria =
			VAR C = Fact_Cierres[Cumplimiento_norm]
			VAR EsPlanAnual = RELATED(Dim_Catalogo[Plan_Anual]) = 1 || RELATED(Dim_Catalogo[Proyecto]) = 1
			VAR EsNegPct = NOT(EsPlanAnual) && Fact_Cierres[Id] IN {"121", "207", "377", "561"}
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(C), "Sin dato",
			    EsPlanAnual, SWITCH(TRUE(), C < 0.8, "Peligro", C < 0.95, "Alerta", C <= 1.0, "Cumplimiento", "Sobrecumplimiento"),
			    EsNegPct, SWITCH(TRUE(), C < 1.02, "Cumplimiento", C <= 1.10, "Alerta", "Peligro"),
			    SWITCH(TRUE(), C < 0.8, "Peligro", C < 1.0, "Alerta", C < 1.05, "Cumplimiento", "Sobrecumplimiento")
			)
		dataType: string
		lineageTag: df341748-ff99-4dc7-b20a-52daed5f3416

	partition Fact_Cierres = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents(RutaBase & "\output\Resultados Consolidados.xlsx"), null, true),
				    Hoja = Origen{[Item="Consolidado Cierres",Kind="Sheet"]}[Data],
				    Promovidos = Table.PromoteHeaders(Hoja, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Promovidos,{{"Id", type text}, {"Indicador", type text}, {"Proceso", type text}, {"Periodicidad", type text}, {"Sentido", type text}, {"Fecha", type date}, {"Año", Int64.Type}, {"Mes", type text}, {"Periodo", type text}, {"Meta", type number}, {"Ejecucion", type number}, {"Cumplimiento", type number}, {"Cumplimiento Real", type number}, {"Meta_Signo", type text}, {"Ejecucion_Signo", type text}, {"Decimales_Meta", Int64.Type}, {"Decimales_Ejecucion", Int64.Type}, {"LLAVE", type text}, {"Tipo_Registro", type text}}),
				    SinNulos = Table.SelectRows(Tipos, each [Id] <> null and [Id] <> "")
				in
				    SinNulos

