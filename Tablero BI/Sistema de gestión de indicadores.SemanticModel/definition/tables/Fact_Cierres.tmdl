		dataType: int64
		lineageTag: b5dcd2be-8442-473f-9dfa-0f752cab2d58
		sourceColumn: Decimales_Ejecucion

	column LLAVE
		dataType: string
		lineageTag: 12fc2e84-7f4c-4861-8688-f6ce94b417e4
