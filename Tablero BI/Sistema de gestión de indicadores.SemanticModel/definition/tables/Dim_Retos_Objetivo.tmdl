table Dim_Retos_Objetivo
	lineageTag: d563ef42-4b43-454d-af75-65632ba7f2bf

	column Linea_Estrategica
		dataType: string
		lineageTag: fd8b4f74-e91d-4f57-8d21-ab9faa2dd811
		sourceColumn: Línea Estratégica

	column Objetivo
		dataType: string
		lineageTag: 5f651fd2-c10a-4bdd-ae49-f21d25e05e2b
		sourceColumn: Objetivo

	column Año
		dataType: int64
		lineageTag: d8b24edf-67aa-4f6e-85d4-5f866f4921e2
		sourceColumn: Año

	column Meta
		dataType: double
		lineageTag: bb83f5a6-00d6-42ae-85bc-589338c29ad0
