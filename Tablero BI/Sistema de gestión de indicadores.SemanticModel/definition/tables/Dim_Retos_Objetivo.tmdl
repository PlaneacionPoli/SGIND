	column Cumplimiento
		dataType: double
		formatString: 0.0%
		lineageTag: e65ae925-bb72-4031-b6d4-843dfcf8b774
		sourceColumn: Cumplimiento

	partition Dim_Retos_Objetivo = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents(RutaBase & "\raw\Retos\Plan de retos.xlsx"), null, true),
				    Hoja = Origen{[Item="Objetivo",Kind="Sheet"]}[Data],
				    Promovidos = Table.PromoteHeaders(Hoja, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Promovidos,{{"Línea Estratégica", type text},{"Objetivo", type text},{"Año", Int64.Type},{"Meta", type number},{"Ejecución", type number},{"Cumplimiento", type number}})
				in
				    Tipos

