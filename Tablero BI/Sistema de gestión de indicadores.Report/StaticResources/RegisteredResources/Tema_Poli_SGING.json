    "#E4006D",
    "#0E2A47",
    "#7FA8C9",
    "#4C6C8F",
    "#A9D9E8"
  ],
  "background": "#FFFFFF",
  "foreground": "#263A58",
  "tableAccent": "#22B2DE",
  "good": "#22C55E",
  "neutral": "#F59E0B",
