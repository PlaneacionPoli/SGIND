# SGIND v2 — Variables de entorno para STAGING
# Copiar a /opt/sgind-v2/.env.staging en el servidor
# NUNCA commitear con valores reales (este archivo está en .gitignore)

# ─── Entorno ─────────────────────────────────────────────────────────────────
ENVIRONMENT=staging
LOG_LEVEL=INFO

# ─── Base de datos ────────────────────────────────────────────────────────────
# Valor generado automáticamente desde docker-compose con la variable POSTGRES_PASSWORD
POSTGRES_USER=sgind
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sgind

# ─── Seguridad JWT ────────────────────────────────────────────────────────────
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── CORS — URL pública del frontend de staging ───────────────────────────────
# Ejemplo: https://sgind-v2-staging.poli.edu.co
CORS_ORIGINS=http://localhost:3000

# ─── Azure AD ────────────────────────────────────────────────────────────────
# Registro de app en portal.azure.com (mismo tenant que producción)
# Redirect URI de staging: https://tu-servidor/api/v1/auth/callback
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Emails institucionales permitidos (vacío = cualquier email del tenant)
ALLOWED_EMAILS=

# ─── Datos Excel ─────────────────────────────────────────────────────────────
# Ruta dentro del contenedor (se monta vía SGIND_DATA_HOST_PATH en compose)
SGIND_DATA_PATH=/data
EXCEL_CACHE_TTL_SECONDS=300

# ─── Ruta de datos en el servidor host ───────────────────────────────────────
# La carpeta data/ del repo en el servidor: /opt/sgind-v2/data
# o una copia montada en el host
SGIND_DATA_HOST_PATH=/opt/sgind-v2/data

# ─── URL pública del frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
